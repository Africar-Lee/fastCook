{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fastcook:catalog:0.1.0",
  "title": "FastCook 结构化菜谱目录设计草案",
  "description": "供评审的数据契约建议。Schema 校验结构，外键、ID 唯一性、图环、数量 min<=max、许可证据、内容哈希及发布资格由独立语义校验完成。通过结构校验不代表配方已核验。",
  "$comment": "发布语义门禁须检查全部引用、alias 歧义、满足关系方向、单跳替代、forbid 优先、步骤修改冲突、有效内容审核与来源许可。数据包解析前另设字节大小上限。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "release_state",
    "default_locale",
    "ingredients",
    "dishes",
    "recipes",
    "substitution_rules",
    "pantry_templates",
    "sources",
    "reviews"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "release_state": {
      "enum": [
        "draft",
        "release_candidate",
        "published"
      ]
    },
    "default_locale": {
      "$ref": "#/$defs/Locale"
    },
    "notes": {
      "$ref": "#/$defs/LocalizedText"
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/Ingredient"
      }
    },
    "dishes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/Dish"
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/Recipe"
      }
    },
    "substitution_rules": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/SubstitutionRule"
      }
    },
    "pantry_templates": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/PantryTemplate"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/Source"
      }
    },
    "reviews": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/ReviewRecord"
      }
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "Locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$",
      "description": "产品采用的语言标签子集；是否支持该标签由构建工具校验。"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "LocalizedName": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/Locale"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "LocalizedText": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/Locale"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "SourceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "ReviewState": {
      "enum": [
        "pending_review",
        "reviewed",
        "rejected"
      ],
      "description": "工作流状态；发布资格以匹配当前内容哈希的审核记录为准。"
    },
    "Alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "resolution"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "resolution": {
          "enum": [
            "automatic",
            "needs_confirmation"
          ]
        }
      },
      "description": "同一语言下相同归一化文本可以指向多个 Ingredient；多个候选须全部标为 needs_confirmation，由用户消歧。"
    },
    "Ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingredient_id",
        "names",
        "aliases",
        "category",
        "selectable",
        "taxonomy_parent_id",
        "matching_parent_ids",
        "implicit_staple",
        "source_ids",
        "review_state"
      ],
      "properties": {
        "ingredient_id": {
          "$ref": "#/$defs/Id"
        },
        "names": {
          "$ref": "#/$defs/LocalizedName"
        },
        "aliases": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/Locale"
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 40,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/Alias"
            }
          }
        },
        "category": {
          "enum": [
            "vegetable",
            "fruit",
            "meat",
            "seafood",
            "egg",
            "soy",
            "grain",
            "dairy",
            "seasoning",
            "other"
          ]
        },
        "selectable": {
          "type": "boolean",
          "description": "纯导航分类节点设为 false；可选的泛指食材仍可设为 true。"
        },
        "taxonomy_parent_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ],
          "description": "仅用于导航和分类；此关系不产生可制作性满足或替代关系。"
        },
        "matching_parent_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Id"
          },
          "description": "逐条审核的具体原料到泛指原料的满足边。建议按无环图求传递闭包，逆向仅产生需确认状态；兄弟节点互不满足。该图不包含替代边。"
        },
        "implicit_staple": {
          "type": "boolean",
          "description": "是否计入隐含常备项。该产品假设须由用户决策确认，与 role、importance、存储位置独立。"
        },
        "source_ids": {
          "$ref": "#/$defs/SourceIds"
        },
        "review_state": {
          "$ref": "#/$defs/ReviewState"
        }
      }
    },
    "Dish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dish_id",
        "names"
      ],
      "properties": {
        "dish_id": {
          "$ref": "#/$defs/Id"
        },
        "names": {
          "$ref": "#/$defs/LocalizedName"
        }
      }
    },
    "MeasuredUnit": {
      "enum": [
        "g",
        "ml",
        "piece",
        "tbsp",
        "tsp"
      ]
    },
    "QuantityConventions": {
      "description": "公制勺定义固定为 tbsp=15 ml、tsp=5 ml；原始量勺标准不明时须人工核实。piece 允许分数，类型匹配不保证数量充足。",
      "allOf": [
        {
          "if": {
            "properties": {
              "unit": {
                "enum": [
                  "tbsp",
                  "tsp"
                ]
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "required": [
              "spoon_standard"
            ]
          },
          "else": {
            "not": {
              "required": [
                "spoon_standard"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit": {
                "enum": [
                  "piece",
                  "tbsp",
                  "tsp"
                ]
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 200
              },
              "min": {
                "maximum": 200
              },
              "max": {
                "maximum": 200
              }
            }
          }
        }
      ]
    },
    "Quantity": {
      "description": "精确量、区间量、适量三选一。Schema 不验证 min<=max，也不验证实际分量是否足够或不同单位之间是否可换算。",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 50000
            },
            "unit": {
              "$ref": "#/$defs/MeasuredUnit"
            },
            "spoon_standard": {
              "const": "metric_15ml_5ml"
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/QuantityConventions"
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "unit"
          ],
          "properties": {
            "min": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 50000
            },
            "max": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 50000
            },
            "unit": {
              "$ref": "#/$defs/MeasuredUnit"
            },
            "spoon_standard": {
              "const": "metric_15ml_5ml"
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/QuantityConventions"
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit"
          ],
          "properties": {
            "unit": {
              "const": "to_taste"
            }
          }
        }
      ]
    },
    "StepChange": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step_id",
            "action",
            "text",
            "requirement_ids"
          ],
          "properties": {
            "step_id": {
              "$ref": "#/$defs/Id"
            },
            "action": {
              "const": "replace"
            },
            "text": {
              "$ref": "#/$defs/LocalizedText"
            },
            "requirement_ids": {
              "type": "array",
              "maxItems": 40,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/Id"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step_id",
            "action"
          ],
          "properties": {
            "step_id": {
              "$ref": "#/$defs/Id"
            },
            "action": {
              "const": "skip"
            }
          }
        }
      ],
      "description": "绑定本 Recipe 的 step_id。替换须同步更新 requirement_ids；跳过或替换后重新检查步骤用料一致性。同一阶段存在相互冲突的修改时拒绝该匹配方案，交由人工审核。"
    },
    "StepChanges": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/StepChange"
      }
    },
    "Omission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "step_changes"
      ],
      "properties": {
        "note": {
          "$ref": "#/$defs/LocalizedText"
        },
        "step_changes": {
          "$ref": "#/$defs/StepChanges"
        }
      },
      "description": "仅在本需求被省略时应用；空 step_changes 仅适用于原始步骤已明确条件化的用料，须人工审核。"
    },
    "Requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "ingredient_id",
        "role",
        "importance",
        "consumes",
        "quantity"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/Id"
        },
        "ingredient_id": {
          "$ref": "#/$defs/Id"
        },
        "role": {
          "enum": [
            "main",
            "secondary",
            "seasoning",
            "garnish"
          ],
          "description": "展示角色；main 不隐含 required，也不决定存储位置。"
        },
        "importance": {
          "enum": [
            "required",
            "important",
            "optional"
          ],
          "description": "required 为身份或可执行性的必要条件，important 缺失有明显影响，optional 缺失影响轻微。"
        },
        "consumes": {
          "type": "boolean",
          "description": "参与占用与使用后确认移除；不表示已经记录或确认数量。"
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "preparation": {
          "$ref": "#/$defs/LocalizedText"
        },
        "omission": {
          "$ref": "#/$defs/Omission"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "importance": {
                "enum": [
                  "important",
                  "optional"
                ]
              }
            },
            "required": [
              "importance"
            ]
          },
          "then": {
            "required": [
              "omission"
            ]
          },
          "else": {
            "not": {
              "required": [
                "omission"
              ]
            }
          }
        }
      ]
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "text",
        "requirement_ids"
      ],
      "properties": {
        "step_id": {
          "$ref": "#/$defs/Id"
        },
        "text": {
          "$ref": "#/$defs/LocalizedText"
        },
        "requirement_ids": {
          "type": "array",
          "maxItems": 40,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Id"
          }
        }
      },
      "description": "数组次序为执行顺序；稳定 ID 在重新排序时保留。所有 requirement_ids 都必须引用本 Recipe 的需求。"
    },
    "CookingMethod": {
      "enum": [
        "stir_fry",
        "pan_fry",
        "deep_fry",
        "boil",
        "steam",
        "braise",
        "roast",
        "cold_mix",
        "mixed"
      ]
    },
    "EquipmentSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equipment",
        "minutes",
        "burner_slots"
      ],
      "properties": {
        "equipment": {
          "enum": [
            "wok",
            "frying_pan",
            "pot",
            "steamer",
            "oven",
            "air_fryer",
            "rice_cooker",
            "microwave",
            "pressure_cooker",
            "electric_steamer"
          ]
        },
        "minutes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1440
        },
        "burner_slots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      },
      "description": "为厨具筛选保留占用需求；只有累计分钟数不能推导可靠的并行完成时间。"
    },
    "Recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_id",
        "dish_id",
        "name",
        "variant",
        "original_locale",
        "course",
        "cooking_method",
        "servings",
        "time_minutes",
        "spicy_level",
        "equipment_slots",
        "requirements",
        "steps",
        "substitution_overrides",
        "source_ids",
        "review_state"
      ],
      "properties": {
        "recipe_id": {
          "$ref": "#/$defs/Id"
        },
        "dish_id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "$ref": "#/$defs/LocalizedName"
        },
        "variant": {
          "$ref": "#/$defs/LocalizedName"
        },
        "original_locale": {
          "$ref": "#/$defs/Locale"
        },
        "course": {
          "enum": [
            "meat",
            "veg",
            "soup",
            "staple",
            "cold"
          ],
          "description": "沿用设计书的菜单分类，用于配餐与展示；veg 不构成素食或过敏原保证。"
        },
        "cooking_method": {
          "$ref": "#/$defs/CookingMethod"
        },
        "servings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "time_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "spicy_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "equipment_slots": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/EquipmentSlot"
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/Requirement"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "substitution_overrides": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/RecipeSubstitutionOverride"
          }
        },
        "source_ids": {
          "$ref": "#/$defs/SourceIds"
        },
        "review_state": {
          "$ref": "#/$defs/ReviewState"
        }
      }
    },
    "SubstitutionConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cooking_methods",
        "requires_available_ingredient_ids",
        "requires_confirmation"
      ],
      "properties": {
        "cooking_methods": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/CookingMethod"
          }
        },
        "requires_available_ingredient_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "requires_confirmation": {
          "type": "boolean"
        }
      },
      "description": "所有非空条件均须满足。空 cooking_methods 表示无方法限制。requires_available_ingredient_ids 仅检查本菜谱已列出且实际采用的配料，须直接或经审核的满足层级可用，禁止引入未列用量的新配料或再通过替代满足；未确认的条件保持不确定。该约束由语义门禁和引擎检查。"
    },
    "QuantityRatio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_unit",
        "substitute_unit",
        "factor"
      ],
      "properties": {
        "required_unit": {
          "$ref": "#/$defs/MeasuredUnit"
        },
        "substitute_unit": {
          "$ref": "#/$defs/MeasuredUnit"
        },
        "factor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      },
      "description": "替代物用量=原需求数值×factor，仅适用列明单位；勺按固定公制标准。比例缺失或不适用于原需求时，须有已审核且可执行的 usage_note 并经用户确认；缺少用量处理依据时禁用规则。该约束由语义门禁和引擎检查。"
    },
    "SubstitutionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "scope",
        "required_ingredient_id",
        "substitute_ingredient_id",
        "level",
        "conditions",
        "usage_note",
        "step_policy",
        "source_ids",
        "review_state"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/Id"
        },
        "scope": {
          "enum": [
            "global",
            "recipe"
          ]
        },
        "recipe_id": {
          "$ref": "#/$defs/Id"
        },
        "required_ingredient_id": {
          "$ref": "#/$defs/Id"
        },
        "substitute_ingredient_id": {
          "$ref": "#/$defs/Id"
        },
        "level": {
          "enum": [
            "equivalent",
            "acceptable",
            "poor"
          ]
        },
        "conditions": {
          "$ref": "#/$defs/SubstitutionConditions"
        },
        "quantity_ratio": {
          "$ref": "#/$defs/QuantityRatio"
        },
        "usage_note": {
          "$ref": "#/$defs/LocalizedText"
        },
        "step_policy": {
          "enum": [
            "ingredient_replacement_only",
            "recipe_step_changes_required"
          ]
        },
        "source_ids": {
          "$ref": "#/$defs/SourceIds"
        },
        "review_state": {
          "$ref": "#/$defs/ReviewState"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "recipe"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "required": [
              "recipe_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "recipe_id"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "step_policy": {
                "const": "recipe_step_changes_required"
              }
            },
            "required": [
              "step_policy"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "const": "recipe"
              }
            }
          }
        }
      ],
      "description": "有向边，用户拥有 substitute 才能满足 required；最多执行一条替代边，不反向、不连锁、不沿类别自动推广规则端点。global 的 poor 默认不生效；recipe 规则须通过该菜谱 requirement 上的 allow 激活。需要更改步骤的替代必须绑定菜谱级步骤修改。"
    },
    "RecipeSubstitutionOverride": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirement_id",
            "rule_id",
            "action",
            "note",
            "step_changes"
          ],
          "properties": {
            "requirement_id": {
              "$ref": "#/$defs/Id"
            },
            "rule_id": {
              "$ref": "#/$defs/Id"
            },
            "action": {
              "const": "allow"
            },
            "note": {
              "$ref": "#/$defs/LocalizedText"
            },
            "step_changes": {
              "$ref": "#/$defs/StepChanges"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirement_id",
            "rule_id",
            "action",
            "note"
          ],
          "properties": {
            "requirement_id": {
              "$ref": "#/$defs/Id"
            },
            "rule_id": {
              "$ref": "#/$defs/Id"
            },
            "action": {
              "const": "forbid"
            },
            "note": {
              "$ref": "#/$defs/LocalizedText"
            }
          }
        }
      ],
      "description": "rule_id 引用根替代规则，requirement_id 引用所属菜谱需求。forbid 优先于 allow；对同需求同有向原料对的重复规则也不可绕过禁止。scope=recipe 必须属于本菜谱。"
    },
    "PantryTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "names",
        "region",
        "ingredient_ids",
        "source_ids",
        "review_state"
      ],
      "properties": {
        "template_id": {
          "$ref": "#/$defs/Id"
        },
        "names": {
          "$ref": "#/$defs/LocalizedName"
        },
        "region": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "ingredient_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "source_ids": {
          "$ref": "#/$defs/SourceIds"
        },
        "review_state": {
          "$ref": "#/$defs/ReviewState"
        }
      },
      "description": "模板保存候选清单，用户是否拥有另存在本地库存；隐含常备项是否从模板移除由语义门禁按产品决策检查。"
    },
    "License": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "verified",
            "rejected"
          ]
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "evidence_locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "evidence_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "attribution": {
          "$ref": "#/$defs/LocalizedText"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "verified"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "identifier",
              "evidence_locator",
              "evidence_sha256"
            ]
          }
        }
      ],
      "description": "许可声明与使用权限分别核验。verified 仍须有匹配 Source 内容哈希的 license 审核记录；项目总许可不能覆盖上游逐项义务。"
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "provenance",
        "revision",
        "license"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/Id"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "origin",
            "locator",
            "generation"
          ],
          "properties": {
            "kind": {
              "enum": [
                "original",
                "upstream",
                "contribution",
                "editorial_draft"
              ]
            },
            "origin": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "generation": {
              "enum": [
                "human",
                "ai_assisted",
                "unknown"
              ]
            }
          }
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifier"
          ],
          "properties": {
            "identifier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "snapshot_sha256": {
              "$ref": "#/$defs/Sha256"
            }
          }
        },
        "license": {
          "$ref": "#/$defs/License"
        }
      },
      "description": "upstream 使用固定 commit 和仓库相对路径，发布门禁要求保留快照及 SHA-256；locator 只作证据定位，导入器不得据此自动读取任意本地路径或联网。图片若引入，须有独立 Source 与许可证据。"
    },
    "ReviewRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "subject_type",
        "subject_id",
        "subject_sha256",
        "dependency_sha256",
        "hash_format",
        "check",
        "outcome",
        "reviewer",
        "reviewed_at",
        "evidence"
      ],
      "properties": {
        "review_id": {
          "$ref": "#/$defs/Id"
        },
        "subject_type": {
          "enum": [
            "ingredient",
            "dish",
            "recipe",
            "substitution_rule",
            "pantry_template",
            "source"
          ]
        },
        "subject_id": {
          "$ref": "#/$defs/Id"
        },
        "subject_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "dependency_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "hash_format": {
          "const": "sha256_rfc8785"
        },
        "check": {
          "enum": [
            "structural",
            "semantic",
            "cooking",
            "license"
          ]
        },
        "outcome": {
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "evidence": {
          "$ref": "#/$defs/LocalizedText"
        }
      },
      "description": "subject_sha256 对目标实体经 RFC 8785 规范化的完整内容计算。dependency_sha256 对去重、按 subject_type/subject_id 排序的传递依赖实体数组计算，排除 reviews；包括原料满足图、同需求可用全局规则和来源。内容或依赖变化使旧审核失效。结构审核、人工语义审核、实际烹饪审核和许可审核独立记录；draft 可无审核记录，发布门禁须按已确认审核政策检查通过记录。format 断言须在验证器中显式启用。"
    }
  }
}
