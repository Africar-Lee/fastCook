  "steps": [
    {
      "step_id": "step_mix_egg",
      "text": {
        "zh-CN": "将鸡蛋打散，加入盐，再缓慢加入 250 毫升温水，边加边搅匀；温水以不烫手为准，避免将蛋液烫成絮状。"
      },
      "requirement_ids": [
        "req_egg",
        "req_salt",
        "req_water"
      ]
    },
    {
      "step_id": "step_strain",
      "text": {
        "zh-CN": "将蛋液过滤到浅耐热碗中，撇去表面泡沫，盖上一只耐热盘。"
      },
      "requirement_ids": [
        "req_egg"
      ]
    },
    {
      "step_id": "step_boil_water",
      "text": {
        "zh-CN": "蒸锅加入剩余 1000 毫升水，放好蒸架并大火煮沸，水面保持低于蒸架。"
      },
      "requirement_ids": [
        "req_water"
      ]
    },
    {
      "step_id": "step_steam_egg",
      "text": {
        "zh-CN": "将蛋碗放入蒸锅，加盖后转中小火，保持有蒸汽，蒸约 12 至 15 分钟。检查中心完全凝固且鸡蛋熟透；若仍有流动蛋液，每次再蒸 2 分钟后检查。"
      },
      "requirement_ids": [
        "req_egg"
      ]
    },
    {
      "step_id": "step_rest",
      "text": {
        "zh-CN": "关火后静置约 2 分钟，小心取出蛋碗并揭开盖盘。"
      },
      "requirement_ids": [
        "req_egg"
      ]
    },
    {
      "step_id": "step_add_light_soy",
      "text": {
        "zh-CN": "将生抽均匀淋在蛋羹表面。"
      },
      "requirement_ids": [
        "req_light_soy_sauce"
      ]
    },
    {
      "step_id": "step_add_sesame_oil",
      "text": {
        "zh-CN": "在蛋羹表面淋入香油。"
      },
      "requirement_ids": [
        "req_sesame_oil"
      ]
    },
    {
      "step_id": "step_add_scallion",
      "text": {
        "zh-CN": "撒上葱花后食用。"
      },
      "requirement_ids": [
        "req_scallion"
      ]
    }
  ],
