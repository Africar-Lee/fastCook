        "zh-CN": "按原文使用香醋，尚未核对其他醋的用量与风味。"
      }
    }
  ],
  "steps": [
    {
      "step_id": "step_1",
      "text": {
        "zh-CN": "去掉青椒蒂，用自来水冲洗干净。"
      },
      "requirement_ids": [
        "req_green_pepper"
      ]
    },
    {
      "step_id": "step_2",
      "text": {
        "zh-CN": "青椒切长片，平均一个青椒纵向切成 3-4 片即可。"
      },
      "requirement_ids": [
        "req_green_pepper"
      ]
    },
    {
      "step_id": "step_3",
      "text": {
        "zh-CN": "大蒜去皮，切成碎末，体积在 2mm x 2mm x 2mm 即可。"
      },
      "requirement_ids": [
        "req_garlic"
      ]
    },
    {
      "step_id": "step_4",
      "text": {
        "zh-CN": "调料 1：拿一个小碗倒入 20ml 油，将大蒜末放入其中。"
      },
      "requirement_ids": [
        "req_cooking_oil",
        "req_garlic"
      ]
    },
    {
      "step_id": "step_5",
      "text": {
        "zh-CN": "调料 2：白糖、生抽、醋、盐全部倒入砵（碗）等容器，搅拌。"
      },
      "requirement_ids": [
        "req_sugar",
        "req_light_soy_sauce",
        "req_aromatic_vinegar",
        "req_salt"
      ]
    },
    {
      "step_id": "step_6",
      "text": {
        "zh-CN": "将 调料 1 倒入锅中，开火加热 5 成放入青椒，青椒片不要叠在一起，单独成片放置锅中。"
      },
      "requirement_ids": [
        "req_cooking_oil",
        "req_garlic",
        "req_green_pepper"
      ]
    },
    {
      "step_id": "step_7",
      "text": {
        "zh-CN": "用锅铲不停的按压青椒，合适的时候翻面。"
      },
      "requirement_ids": [
        "req_green_pepper"
      ]
    },
    {
      "step_id": "step_8",
      "text": {
        "zh-CN": "翻炒约 2 分钟，待青椒表皮出现褶皱时，倒入 调料 2。"
      },
      "requirement_ids": [
        "req_green_pepper",
        "req_sugar",
        "req_light_soy_sauce",
        "req_aromatic_vinegar",
        "req_salt"
      ]
    },
    {
      "step_id": "step_9",
      "text": {
        "zh-CN": "加大火候继续翻炒 30s 后即可出锅盛入盘中。"
      },
      "requirement_ids": [
        "req_green_pepper"
      ]
    }
  ],
  "source_ids": [
