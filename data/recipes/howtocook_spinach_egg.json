  "substitution_overrides": [],
  "steps": [
    {
      "step_id": "step_1",
      "text": {
        "zh-CN": "菠菜去根，洗净，放在篮子里，焯水"
      },
      "requirement_ids": [
        "req_spinach",
        "req_water"
      ]
    },
    {
      "step_id": "step_2",
      "text": {
        "zh-CN": "将鸡蛋打入碗中，搅匀"
      },
      "requirement_ids": [
        "req_egg"
      ]
    },
    {
      "step_id": "step_3",
      "text": {
        "zh-CN": "热锅，加入 10ml 油"
      },
      "requirement_ids": [
        "req_cooking_oil"
      ]
    },
    {
      "step_id": "step_4",
      "text": {
        "zh-CN": "油热后，倒入鸡蛋液，中火翻炒 15 秒，先煎成蛋饼，然后再用锅铲切成小块"
      },
      "requirement_ids": [
        "req_egg"
      ]
    },
    {
      "step_id": "step_5",
      "text": {
        "zh-CN": "关火，将鸡蛋块 盛到盘子中，不要洗锅"
      },
      "requirement_ids": [
        "req_egg"
      ]
    },
    {
      "step_id": "step_6",
      "text": {
        "zh-CN": "重新开火，倒入 5ml 油，油热后，放入菠菜，大火 翻炒 15 秒后，倒入鸡蛋块，翻炒均匀"
      },
      "requirement_ids": [
        "req_cooking_oil",
        "req_spinach",
        "req_egg"
      ]
    },
    {
      "step_id": "step_7",
      "text": {
        "zh-CN": "加入 5g 盐、100ml 饮用水，大火 翻炒 10 秒"
      },
      "requirement_ids": [
        "req_salt",
        "req_water"
      ]
    },
    {
      "step_id": "step_8",
      "text": {
        "zh-CN": "关火，盛盘"
      },
      "requirement_ids": []
    }
  ],
