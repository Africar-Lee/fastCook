  "steps": [
    {
      "step_id": "step_prepare",
      "text": {
        "zh-CN": "将免洗干紫菜撕成小片，鸡蛋打入碗中并充分打散。"
      },
      "requirement_ids": [
        "req_dried_laver",
        "req_egg"
      ]
    },
    {
      "step_id": "step_boil_water",
      "text": {
        "zh-CN": "汤锅倒入水，大火煮至沸腾。"
      },
      "requirement_ids": [
        "req_water"
      ]
    },
    {
      "step_id": "step_cook_laver",
      "text": {
        "zh-CN": "加入紫菜，转中火煮约 1 分钟至紫菜展开。"
      },
      "requirement_ids": [
        "req_dried_laver"
      ]
    },
    {
      "step_id": "step_cook_egg",
      "text": {
        "zh-CN": "保持汤轻微沸腾，缓慢淋入蛋液，待蛋花成形后轻轻推动，再煮约 1 分钟至鸡蛋完全凝固且熟透。"
      },
      "requirement_ids": [
        "req_egg"
      ]
    },
    {
      "step_id": "step_add_salt",
      "text": {
        "zh-CN": "加入盐并搅匀，关火。"
      },
      "requirement_ids": [
        "req_salt"
      ]
    },
    {
      "step_id": "step_add_white_pepper",
      "text": {
        "zh-CN": "加入白胡椒粉并拌匀。"
      },
      "requirement_ids": [
        "req_white_pepper"
      ]
    },
    {
      "step_id": "step_add_scallion",
      "text": {
        "zh-CN": "加入葱花并拌匀。"
      },
      "requirement_ids": [
        "req_scallion"
      ]
    },
    {
      "step_id": "step_add_sesame_oil",
      "text": {
        "zh-CN": "淋入香油，轻轻搅匀后盛出。"
      },
      "requirement_ids": [
        "req_sesame_oil"
      ]
    }
  ],
