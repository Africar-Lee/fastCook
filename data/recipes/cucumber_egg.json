  "steps": [
    {
      "step_id": "step_prepare_cucumber",
      "text": {
        "zh-CN": "黄瓜洗净，切成约 3 毫米厚的片。"
      },
      "requirement_ids": [
        "req_cucumber"
      ]
    },
    {
      "step_id": "step_beat_egg",
      "text": {
        "zh-CN": "鸡蛋打入碗中，加入 1 克盐并打散。"
      },
      "requirement_ids": [
        "req_egg",
        "req_salt"
      ]
    },
    {
      "step_id": "step_cook_egg",
      "text": {
        "zh-CN": "炒锅中火加热，加入 12 毫升食用油，倒入蛋液，翻炒至完全凝固且熟透后盛出。"
      },
      "requirement_ids": [
        "req_cooking_oil",
        "req_egg"
      ]
    },
    {
      "step_id": "step_cook_cucumber",
      "text": {
        "zh-CN": "锅中加入剩余 8 毫升食用油，放入黄瓜片，中大火翻炒约 2 分钟，至黄瓜略软。"
      },
      "requirement_ids": [
        "req_cooking_oil",
        "req_cucumber"
      ]
    },
    {
      "step_id": "step_combine",
      "text": {
        "zh-CN": "倒回鸡蛋，加入剩余 1 克盐，翻炒约 30 秒至均匀。"
      },
      "requirement_ids": [
        "req_egg",
        "req_salt"
      ]
    },
    {
      "step_id": "step_add_scallion",
      "text": {
        "zh-CN": "加入葱花并翻匀。"
      },
      "requirement_ids": [
        "req_scallion"
      ]
    },
    {
      "step_id": "step_serve",
      "text": {
        "zh-CN": "关火，将炒好的菜盛入盘中。"
      },
      "requirement_ids": []
    }
  ],
