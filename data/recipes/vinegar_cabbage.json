{
  "recipe_id": "vinegar_cabbage",
  "dish_id": "vinegar_cabbage",
  "name": {
    "zh-CN": "醋溜白菜"
  },
  "variant": {
    "zh-CN": "家常做法草稿"
  },
  "original_locale": "zh-CN",
  "course": "veg",
  "cooking_method": "stir_fry",
  "servings": 2,
  "time_minutes": 20,
  "spicy_level": 1,
  "equipment_slots": [
