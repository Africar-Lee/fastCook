  "steps": [
    {
      "step_id": "step_prepare_tofu",
      "text": {
        "zh-CN": "嫩豆腐切成约两厘米的小块，轻拿轻放，倒去包装中剩余液体。"
      },
      "requirement_ids": [
        "req_soft_tofu"
      ]
    },
    {
      "step_id": "step_heat_oil",
      "text": {
        "zh-CN": "炒锅中火加热，加入 15 ml 食用油。"
      },
      "requirement_ids": [
        "req_cooking_oil"
      ]
    },
    {
      "step_id": "step_cook_pork",
      "text": {
        "zh-CN": "猪肉剁成细末后放入锅中，用锅铲划散，翻炒约两分钟至肉末全部变色。"
      },
      "requirement_ids": [
        "req_pork"
      ]
    },
    {
      "step_id": "step_add_ginger",
      "text": {
        "zh-CN": "姜切成细末，加入锅中翻炒约十秒至出香味。"
      },
      "requirement_ids": [
        "req_ginger"
      ]
    },
    {
      "step_id": "step_add_garlic",
      "text": {
        "zh-CN": "蒜切末后加入锅中，翻炒约十秒。"
      },
      "requirement_ids": [
        "req_garlic"
      ]
    },
    {
      "step_id": "step_cook_doubanjiang",
      "text": {
        "zh-CN": "转小火，加入 20 g 豆瓣酱，翻炒约三十秒至油色变红。"
      },
      "requirement_ids": [
        "req_doubanjiang"
      ]
    },
    {
      "step_id": "step_simmer",
      "text": {
        "zh-CN": "加入 120 ml 水，煮沸后轻放入嫩豆腐。小火煮五分钟，轻推锅铲使酱汁流动，保持豆腐完整。"
      },
      "requirement_ids": [
        "req_water",
        "req_soft_tofu"
      ]
    },
    {
      "step_id": "step_add_soy",
      "text": {
        "zh-CN": "加入 5 ml 生抽，轻晃锅身使调味均匀。"
      },
      "requirement_ids": [
        "req_light_soy_sauce"
      ]
    },
    {
      "step_id": "step_thicken",
      "text": {
        "zh-CN": "将 5 g 玉米淀粉与剩余 30 ml 水搅匀，分两次沿锅边倒入，每次轻推均匀。煮约一分钟至酱汁浓稠且重新沸腾。"
      },
      "requirement_ids": [
        "req_corn_starch",
        "req_water"
      ]
    },
    {
      "step_id": "step_add_peppercorn",
      "text": {
        "zh-CN": "将花椒研成细末，均匀撒入锅中，轻推拌匀。"
      },
      "requirement_ids": [
        "req_sichuan_pepper"
      ]
    },
    {
      "step_id": "step_add_scallion",
      "text": {
        "zh-CN": "葱切成葱花，撒在豆腐表面。"
      },
      "requirement_ids": [
        "req_scallion"
      ]
    },
    {
      "step_id": "step_serve",
      "text": {
        "zh-CN": "关火，用宽铲轻轻将豆腐和酱汁盛入深盘。"
      },
      "requirement_ids": [
        "req_soft_tofu"
      ]
    }
  ],
