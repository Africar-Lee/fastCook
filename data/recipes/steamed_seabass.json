  "steps": [
    {
      "step_id": "step_prepare_fish",
      "text": {
        "zh-CN": "将处理好的鲈鱼擦干，在两侧鱼身最厚处各划两刀，保持鱼身完整。"
      },
      "requirement_ids": [
        "req_whole_seabass"
      ]
    },
    {
      "step_id": "step_add_ginger",
      "text": {
        "zh-CN": "将姜片平铺在耐热鱼盘底部。"
      },
      "requirement_ids": [
        "req_ginger"
      ]
    },
    {
      "step_id": "step_place_fish",
      "text": {
        "zh-CN": "将鲈鱼放入耐热鱼盘，鱼身铺平，避免折叠。"
      },
      "requirement_ids": [
        "req_whole_seabass"
      ]
    },
    {
      "step_id": "step_boil_water",
      "text": {
        "zh-CN": "蒸锅加入水并放好蒸架，大火煮沸，确保水面低于蒸架。"
      },
      "requirement_ids": [
        "req_water"
      ]
    },
    {
      "step_id": "step_steam_fish",
      "text": {
        "zh-CN": "将鱼盘放入蒸锅，加盖保持蒸汽充足，蒸约 12 至 15 分钟。检查鱼身最厚处及近骨处已熟透，较厚时继续蒸；取出后倒掉盘中蒸出的汁液。"
      },
      "requirement_ids": [
        "req_whole_seabass"
      ]
    },
    {
      "step_id": "step_add_soy",
      "text": {
        "zh-CN": "将蒸鱼豉油均匀淋在鱼身及盘底。"
      },
      "requirement_ids": [
        "req_steamed_fish_soy_sauce"
      ]
    },
    {
      "step_id": "step_add_scallion",
      "text": {
        "zh-CN": "将葱丝铺在鱼身上。"
      },
      "requirement_ids": [
        "req_scallion"
      ]
    },
    {
      "step_id": "step_pour_oil",
      "text": {
        "zh-CN": "平底锅加入食用油，中火加热至油明显变稀、尚未冒烟时关火，小心将热油均匀淋在鱼身上。"
      },
      "requirement_ids": [
        "req_cooking_oil"
      ]
    }
  ],
