  "steps": [
    {
      "step_id": "step_cut_soak",
      "text": {
        "zh-CN": "土豆去皮切成约两毫米的细丝，放入 600 ml 水中浸泡五分钟。"
      },
      "requirement_ids": [
        "req_potato",
        "req_water"
      ]
    },
    {
      "step_id": "step_drain",
      "text": {
        "zh-CN": "捞出土豆丝并充分沥干，浸泡液弃去。"
      },
      "requirement_ids": [
        "req_potato",
        "req_water"
      ]
    },
    {
      "step_id": "step_heat_oil",
      "text": {
        "zh-CN": "炒锅中火加热，加入 15 ml 食用油。"
      },
      "requirement_ids": [
        "req_cooking_oil"
      ]
    },
    {
      "step_id": "step_add_chili",
      "text": {
        "zh-CN": "干辣椒剪成段，加入锅中翻炒约十秒，至颜色略深。"
      },
      "requirement_ids": [
        "req_dried_chili"
      ]
    },
    {
      "step_id": "step_add_garlic",
      "text": {
        "zh-CN": "蒜切成末，加入锅中翻炒约十秒至出香味。"
      },
      "requirement_ids": [
        "req_garlic"
      ]
    },
    {
      "step_id": "step_cook_potato",
      "text": {
        "zh-CN": "放入沥干的土豆丝，转中大火连续翻炒约三分钟，至土豆丝由生硬变得可以弯曲。"
      },
      "requirement_ids": [
        "req_potato"
      ]
    },
    {
      "step_id": "step_finish",
      "text": {
        "zh-CN": "加入 15 ml 香醋和 2 g 盐，继续翻炒约一分钟，至土豆丝熟透且仍有脆感后盛出。"
      },
      "requirement_ids": [
        "req_aromatic_vinegar",
        "req_salt",
        "req_potato"
      ]
    }
  ],
