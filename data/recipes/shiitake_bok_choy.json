  "steps": [
    {
      "step_id": "step_prepare",
      "text": {
        "zh-CN": "鲜香菇洗净去掉硬蒂，切成厚片。小白菜洗净沥干，较粗菜梗纵向剖开，与菜叶分开放置。"
      },
      "requirement_ids": [
        "req_fresh_shiitake",
        "req_bok_choy"
      ]
    },
    {
      "step_id": "step_heat_oil",
      "text": {
        "zh-CN": "炒锅中火加热，加入 15 ml 食用油。"
      },
      "requirement_ids": [
        "req_cooking_oil"
      ]
    },
    {
      "step_id": "step_add_garlic",
      "text": {
        "zh-CN": "蒜切末加入锅中，翻炒约十秒至出香味。"
      },
      "requirement_ids": [
        "req_garlic"
      ]
    },
    {
      "step_id": "step_cook_mushrooms",
      "text": {
        "zh-CN": "放入香菇，翻炒约两分钟至香菇略软、表面吸附油脂。"
      },
      "requirement_ids": [
        "req_fresh_shiitake"
      ]
    },
    {
      "step_id": "step_cook_stems",
      "text": {
        "zh-CN": "加入小白菜菜梗翻炒一分钟，再加入 40 ml 水，盖锅盖焖煮约一分钟。"
      },
      "requirement_ids": [
        "req_bok_choy",
        "req_water"
      ]
    },
    {
      "step_id": "step_cook_leaves",
      "text": {
        "zh-CN": "揭盖加入菜叶和 1.5 g 盐，翻炒一至两分钟，至香菇与菜梗熟透、菜叶变软。"
      },
      "requirement_ids": [
        "req_bok_choy",
        "req_salt",
        "req_fresh_shiitake"
      ]
    },
    {
      "step_id": "step_add_oyster_sauce",
      "text": {
        "zh-CN": "加入 10 ml 蚝油，翻拌均匀并煮至锅中汁液重新沸腾。"
      },
      "requirement_ids": [
        "req_oyster_sauce"
      ]
    },
    {
      "step_id": "step_serve",
      "text": {
        "zh-CN": "将香菇与小白菜盛入盘中，淋上锅中剩余的少量菜汁。"
      },
      "requirement_ids": [
        "req_fresh_shiitake",
        "req_bok_choy"
      ]
    }
  ],
