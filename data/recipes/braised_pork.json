  "steps": [
    {
      "step_id": "step_blanch_pork",
      "text": {
        "zh-CN": "五花肉块放入锅中，加入 500 毫升水，煮沸后撇去浮沫，再煮约 3 分钟，捞出沥干；倒掉焯肉水并擦干锅。"
      },
      "requirement_ids": [
        "req_pork_belly",
        "req_water"
      ]
    },
    {
      "step_id": "step_melt_sugar",
      "text": {
        "zh-CN": "锅中加入食用油和冰糖，小火缓慢搅动至冰糖融化并呈浅琥珀色。"
      },
      "requirement_ids": [
        "req_cooking_oil",
        "req_rock_sugar"
      ]
    },
    {
      "step_id": "step_color_pork",
      "text": {
        "zh-CN": "加入充分沥干的五花肉，小心翻动约 2 分钟，使肉块均匀裹上糖色。"
      },
      "requirement_ids": [
        "req_pork_belly",
        "req_rock_sugar"
      ]
    },
    {
      "step_id": "step_add_wine",
      "text": {
        "zh-CN": "沿锅边加入料酒，翻动约 20 秒。"
      },
      "requirement_ids": [
        "req_cooking_wine"
      ]
    },
    {
      "step_id": "step_add_liquid",
      "text": {
        "zh-CN": "加入生抽和剩余 500 毫升水，搅匀后煮沸。使用能让汤汁基本浸到肉块的锅。"
      },
      "requirement_ids": [
        "req_light_soy_sauce",
        "req_water"
      ]
    },
    {
      "step_id": "step_add_dark_soy",
      "text": {
        "zh-CN": "加入老抽，翻动肉块使颜色均匀。"
      },
      "requirement_ids": [
        "req_dark_soy_sauce"
      ]
    },
    {
      "step_id": "step_add_ginger",
      "text": {
        "zh-CN": "加入姜片并拌匀。"
      },
      "requirement_ids": [
        "req_ginger"
      ]
    },
    {
      "step_id": "step_add_star_anise",
      "text": {
        "zh-CN": "加入八角。"
      },
      "requirement_ids": [
        "req_star_anise"
      ]
    },
    {
      "step_id": "step_add_cinnamon",
      "text": {
        "zh-CN": "加入桂皮。"
      },
      "requirement_ids": [
        "req_cinnamon"
      ]
    },
    {
      "step_id": "step_add_bay_leaf",
      "text": {
        "zh-CN": "加入香叶。"
      },
      "requirement_ids": [
        "req_bay_leaf"
      ]
    },
    {
      "step_id": "step_simmer",
      "text": {
        "zh-CN": "转小火加盖炖约 60 分钟，每隔 15 分钟翻动一次，保持轻微沸腾；炖至五花肉熟透、筷子能轻松插入。若汤汁下降过快，调小火力并盖严锅盖。"
      },
      "requirement_ids": [
        "req_pork_belly"
      ]
    },
    {
      "step_id": "step_reduce",
      "text": {
        "zh-CN": "开盖转中火，翻动肉块收汁约 3 分钟，至汤汁浓稠并包裹肉块后关火盛出。"
      },
      "requirement_ids": [
        "req_pork_belly"
      ]
    }
  ],
