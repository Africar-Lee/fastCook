  "steps": [
    {
      "step_id": "step_prepare",
      "text": {
        "zh-CN": "番茄洗净去蒂，切成约两厘米的小块；鸡蛋打入碗中搅散。"
      },
      "requirement_ids": [
        "req_tomato",
        "req_egg"
      ]
    },
    {
      "step_id": "step_cook_egg",
      "text": {
        "zh-CN": "炒锅中火加热，倒入 12 ml 食用油，再倒入蛋液。轻推至蛋液凝固成块后盛出。"
      },
      "requirement_ids": [
        "req_cooking_oil",
        "req_egg"
      ]
    },
    {
      "step_id": "step_cook_tomato",
      "text": {
        "zh-CN": "锅中加入剩余 8 ml 食用油，放入番茄，中火翻炒约三分钟，至番茄边缘变软并析出汁液。"
      },
      "requirement_ids": [
        "req_cooking_oil",
        "req_tomato"
      ]
    },
    {
      "step_id": "step_add_sugar",
      "text": {
        "zh-CN": "向番茄中加入 3 g 白糖，翻拌至糖溶解。"
      },
      "requirement_ids": [
        "req_sugar",
        "req_tomato"
      ]
    },
    {
      "step_id": "step_finish",
      "text": {
        "zh-CN": "将鸡蛋倒回锅中，加入 2 g 盐，翻炒约一分钟。确认鸡蛋完全凝固、番茄熟软后盛出。"
      },
      "requirement_ids": [
        "req_egg",
        "req_salt",
        "req_tomato"
      ]
    }
  ],
