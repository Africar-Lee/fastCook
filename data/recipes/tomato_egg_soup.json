  "steps": [
    {
      "step_id": "step_prepare",
      "text": {
        "zh-CN": "番茄洗净切成小块，鸡蛋打入另一只碗中并充分打散。"
      },
      "requirement_ids": [
        "req_tomato",
        "req_egg"
      ]
    },
    {
      "step_id": "step_fry_tomato",
      "text": {
        "zh-CN": "汤锅加入食用油，中火放入番茄，翻炒约 2 分钟至番茄变软出汁。"
      },
      "requirement_ids": [
        "req_cooking_oil",
        "req_tomato"
      ]
    },
    {
      "step_id": "step_boil_soup",
      "text": {
        "zh-CN": "倒入水，煮沸后转中火继续煮约 3 分钟。"
      },
      "requirement_ids": [
        "req_water"
      ]
    },
    {
      "step_id": "step_cook_egg",
      "text": {
        "zh-CN": "保持汤轻微沸腾，沿锅边缓慢淋入蛋液，待蛋花成形后轻轻推动，再煮约 1 分钟至鸡蛋完全凝固且熟透。"
      },
      "requirement_ids": [
        "req_egg"
      ]
    },
    {
      "step_id": "step_add_salt",
      "text": {
        "zh-CN": "加入盐并搅匀，关火。"
      },
      "requirement_ids": [
        "req_salt"
      ]
    },
    {
      "step_id": "step_add_scallion",
      "text": {
        "zh-CN": "加入葱花并轻轻拌匀。"
      },
      "requirement_ids": [
        "req_scallion"
      ]
    },
    {
      "step_id": "step_add_sesame_oil",
      "text": {
        "zh-CN": "淋入香油，拌匀后盛入汤碗。"
      },
      "requirement_ids": [
        "req_sesame_oil"
      ]
    }
  ],
