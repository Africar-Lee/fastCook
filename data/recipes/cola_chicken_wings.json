  "steps": [
    {
      "step_id": "step_prepare_wings",
      "text": {
        "zh-CN": "在每只鸡翅中两面各划两道浅口，保持肉与骨相连，再擦干表面。"
      },
      "requirement_ids": [
        "req_chicken_wing"
      ]
    },
    {
      "step_id": "step_heat_oil",
      "text": {
        "zh-CN": "炒锅中火加热，倒入食用油并铺开。"
      },
      "requirement_ids": [
        "req_cooking_oil"
      ]
    },
    {
      "step_id": "step_add_ginger",
      "text": {
        "zh-CN": "加入姜片，中小火翻炒约 20 秒。"
      },
      "requirement_ids": [
        "req_ginger"
      ]
    },
    {
      "step_id": "step_sear_wings",
      "text": {
        "zh-CN": "将鸡翅单层放入锅中，中火每面煎约 3 分钟，至两面略上色。"
      },
      "requirement_ids": [
        "req_chicken_wing"
      ]
    },
    {
      "step_id": "step_add_wine",
      "text": {
        "zh-CN": "沿锅边加入料酒，翻动鸡翅约 20 秒。"
      },
      "requirement_ids": [
        "req_cooking_wine"
      ]
    },
    {
      "step_id": "step_braise",
      "text": {
        "zh-CN": "倒入可乐和生抽，煮沸后转小火，加盖焖约 20 分钟，中途翻面一次。检查最厚处及近骨处已熟透，必要时继续小火焖煮。"
      },
      "requirement_ids": [
        "req_cola",
        "req_light_soy_sauce",
        "req_chicken_wing"
      ]
    },
    {
      "step_id": "step_reduce",
      "text": {
        "zh-CN": "鸡翅熟透后开盖转中火，边翻动边收汁约 3 分钟，至酱汁能挂在鸡翅表面，避免熬干焦糊后盛出。"
      },
      "requirement_ids": [
        "req_chicken_wing",
        "req_cola",
        "req_light_soy_sauce"
      ]
    }
  ],
