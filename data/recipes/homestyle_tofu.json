  "steps": [
    {
      "step_id": "step_prepare_tofu",
      "text": {
        "zh-CN": "老豆腐切成约一厘米厚的片，用厨房纸轻压吸去表面液体。"
      },
      "requirement_ids": [
        "req_firm_tofu"
      ]
    },
    {
      "step_id": "step_pan_fry_tofu",
      "text": {
        "zh-CN": "炒锅加入 25 ml 食用油，中火放入豆腐，分面煎至两面浅金黄后盛出，锅中余油保留。"
      },
      "requirement_ids": [
        "req_cooking_oil",
        "req_firm_tofu"
      ]
    },
    {
      "step_id": "step_add_garlic",
      "text": {
        "zh-CN": "蒜切成片，加入锅中余油，小火翻炒约十秒。"
      },
      "requirement_ids": [
        "req_garlic"
      ]
    },
    {
      "step_id": "step_add_doubanjiang",
      "text": {
        "zh-CN": "加入 10 g 豆瓣酱，小火翻炒约二十秒至出香味。"
      },
      "requirement_ids": [
        "req_doubanjiang"
      ]
    },
    {
      "step_id": "step_add_pepper",
      "text": {
        "zh-CN": "青椒洗净去蒂去籽，切成小块后放入锅中，中火翻炒约一分钟。"
      },
      "requirement_ids": [
        "req_green_pepper"
      ]
    },
    {
      "step_id": "step_braise",
      "text": {
        "zh-CN": "将煎好的豆腐放回锅中，加入 10 ml 生抽和 80 ml 水。轻推拌匀，小火煮约四分钟使豆腐入味。"
      },
      "requirement_ids": [
        "req_firm_tofu",
        "req_light_soy_sauce",
        "req_water"
      ]
    },
    {
      "step_id": "step_reduce",
      "text": {
        "zh-CN": "转中火轻晃锅身，收汁约一分钟，保留少量酱汁，将豆腐与锅中配菜一起盛出。"
      },
      "requirement_ids": [
        "req_firm_tofu"
      ]
    }
  ],
