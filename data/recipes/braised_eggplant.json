  "steps": [
    {
      "step_id": "step_prepare",
      "text": {
        "zh-CN": "茄子洗净去蒂，切成约三厘米的滚刀块，表面擦干后备用。"
      },
      "requirement_ids": [
        "req_eggplant"
      ]
    },
    {
      "step_id": "step_pan_fry",
      "text": {
        "zh-CN": "炒锅加入 25 ml 食用油，中火放入茄子，翻煎约五分钟至几面略微上色、茄子开始变软。"
      },
      "requirement_ids": [
        "req_cooking_oil",
        "req_eggplant"
      ]
    },
    {
      "step_id": "step_add_garlic",
      "text": {
        "zh-CN": "蒜切末，推开部分茄子腾出锅底，加入蒜末翻炒约二十秒后拌匀。"
      },
      "requirement_ids": [
        "req_garlic",
        "req_eggplant"
      ]
    },
    {
      "step_id": "step_add_liquid",
      "text": {
        "zh-CN": "加入 15 ml 生抽和 80 ml 水，轻轻翻拌使茄子均匀接触酱汁。"
      },
      "requirement_ids": [
        "req_light_soy_sauce",
        "req_water",
        "req_eggplant"
      ]
    },
    {
      "step_id": "step_add_dark_soy",
      "text": {
        "zh-CN": "加入 3 ml 老抽，翻拌至酱汁颜色均匀。"
      },
      "requirement_ids": [
        "req_dark_soy_sauce"
      ]
    },
    {
      "step_id": "step_add_sugar",
      "text": {
        "zh-CN": "加入 4 g 白糖，搅动锅中酱汁使其溶解。"
      },
      "requirement_ids": [
        "req_sugar"
      ]
    },
    {
      "step_id": "step_braise",
      "text": {
        "zh-CN": "盖锅盖，小火焖煮五至六分钟，中途轻推一次，至茄子中心熟软。"
      },
      "requirement_ids": [
        "req_eggplant"
      ]
    },
    {
      "step_id": "step_reduce",
      "text": {
        "zh-CN": "揭盖转中火，轻推茄子并收汁一至两分钟，至酱汁能够附着在茄子上后盛出。"
      },
      "requirement_ids": [
        "req_eggplant"
      ]
    }
  ],
