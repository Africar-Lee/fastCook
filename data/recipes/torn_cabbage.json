  "steps": [
    {
      "step_id": "step_prepare",
      "text": {
        "zh-CN": "包菜去掉硬芯，叶片撕成约四厘米大小的块，洗净后充分沥干。"
      },
      "requirement_ids": [
        "req_cabbage"
      ]
    },
    {
      "step_id": "step_heat_oil",
      "text": {
        "zh-CN": "炒锅中火加热，加入 15 ml 食用油。"
      },
      "requirement_ids": [
        "req_cooking_oil"
      ]
    },
    {
      "step_id": "step_add_chili",
      "text": {
        "zh-CN": "干辣椒剪成段，加入锅中翻炒约十秒。"
      },
      "requirement_ids": [
        "req_dried_chili"
      ]
    },
    {
      "step_id": "step_add_garlic",
      "text": {
        "zh-CN": "蒜切片，加入锅中翻炒约十秒至出香味。"
      },
      "requirement_ids": [
        "req_garlic"
      ]
    },
    {
      "step_id": "step_cook_cabbage",
      "text": {
        "zh-CN": "加入包菜，转中大火翻炒三至四分钟，至叶片变软、较厚的叶梗熟透。"
      },
      "requirement_ids": [
        "req_cabbage"
      ]
    },
    {
      "step_id": "step_add_soy",
      "text": {
        "zh-CN": "沿锅边加入 10 ml 生抽，快速翻拌至包菜均匀着色。"
      },
      "requirement_ids": [
        "req_light_soy_sauce",
        "req_cabbage"
      ]
    },
    {
      "step_id": "step_add_vinegar",
      "text": {
        "zh-CN": "加入 5 ml 香醋，翻炒约十秒。"
      },
      "requirement_ids": [
        "req_aromatic_vinegar"
      ]
    },
    {
      "step_id": "step_serve",
      "text": {
        "zh-CN": "关火，将包菜连同少量锅中汁液盛入盘中。"
      },
      "requirement_ids": [
        "req_cabbage"
      ]
    }
  ],
  "substitution_overrides": [],
