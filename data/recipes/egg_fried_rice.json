  "steps": [
    {
      "step_id": "step_prepare",
      "text": {
        "zh-CN": "用饭勺将熟米饭拨散，鸡蛋打入碗中并充分打散。"
      },
      "requirement_ids": [
        "req_cooked_rice",
        "req_egg"
      ]
    },
    {
      "step_id": "step_cook_egg",
      "text": {
        "zh-CN": "炒锅中火加入 10 毫升食用油，倒入蛋液，用锅铲划散，炒至鸡蛋完全凝固且熟透后盛出。"
      },
      "requirement_ids": [
        "req_cooking_oil",
        "req_egg"
      ]
    },
    {
      "step_id": "step_cook_rice",
      "text": {
        "zh-CN": "锅中加入剩余 10 毫升食用油，放入米饭，转中大火边压散边翻炒约 4 分钟，使米饭均匀热透。"
      },
      "requirement_ids": [
        "req_cooking_oil",
        "req_cooked_rice"
      ]
    },
    {
      "step_id": "step_combine",
      "text": {
        "zh-CN": "倒回炒熟的鸡蛋，加入盐，翻炒约 1 分钟，使蛋块、米饭和盐混合均匀。"
      },
      "requirement_ids": [
        "req_egg",
        "req_salt",
        "req_cooked_rice"
      ]
    },
    {
      "step_id": "step_add_scallion",
      "text": {
        "zh-CN": "加入葱花，快速翻炒约 20 秒。"
      },
      "requirement_ids": [
        "req_scallion"
      ]
    },
    {
      "step_id": "step_serve",
      "text": {
        "zh-CN": "关火，将炒好的菜盛入盘中。"
      },
      "requirement_ids": []
    }
  ],
