{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "types": ["react"]
  },
  "include": ["**/*.ts", "**/*.tsx", "../packages/engine/src/**/*.ts"]
}
